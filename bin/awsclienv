#!/bin/bash

# Manage side-by-side installations of the AWS CLI v2 on macOS, as documented
# in README.md.

set -o errexit -o nounset -o pipefail

awsclienv_dir=$HOME/.awsclienv
versions=$awsclienv_dir/versions
install_dir=$awsclienv_dir/bin
changelog_url=https://raw.githubusercontent.com/aws/aws-cli/v2/CHANGELOG.rst
default_base_url=https://raw.githubusercontent.com/hannes-ucsc/awsclienv/main
base_url=${AWSCLIENV_BASE_URL:-$default_base_url}

# The name this script was invoked by, and the directory that name lives in,
# which is where its other names live, too. Neither means anything when a
# shell is reading this from a pipe, and neither is consulted then.
#
name=$(basename "$0")
bin=$(cd "$(dirname "$0")" && pwd)

usage() {
	cat <<EOF
Usage:
  awsclienv activate
      Install the shims and set up tab completion for the AWS CLI
  awsclienv install
      Install the version of the AWS CLI specified by AWSCLIENV_VERSION, or, if
      that variable is not set, the most recent version available
  awsclienv list
      List the versions of the AWS CLI installed locally, oldest first
  awsclienv purge
      Delete every installed version of the AWS CLI except the one specified by
      AWSCLIENV_VERSION, or, if that variable is not set, the most recent
      version that's installed
  awsclienv deactivate
      Remove the shims and tear down tab completion for the AWS CLI
  awsclienv self-update
      Replace awsclienv with the most recent version from GitHub
  awsclienv self-remove
      Remove awsclienv and all installed versions of the AWS CLI
EOF
}

# The words bash offers when completing `awsclienv`, which are its
# subcommands, and only where a subcommand goes. They are read back out of the
# synopsis, so that it stays the one place they are listed.
#
complete_subcommand() {
	local command=$1 word=$2 previous=$3 subcommand
	if test "$previous" = "$command"; then
		for subcommand in $(usage | awk '$1 == "awsclienv" { print $2 }'); do
			case $subcommand in
				"$word"*)
					echo "$subcommand"
					;;
			esac
		done
	fi
}

check_no_args() {
	local subcommand=$1
	shift
	if test $# -ne 0; then
		echo "The $subcommand subcommand takes no arguments: $*" >&2
		usage >&2
		exit 1
	fi
}

# The installed versions, one per line, oldest first. Sorting by numeric
# version component, not lexicographically, so that 2.36.9 precedes 2.36.38.
#
installed_versions() {
	for dir in "$versions"/*; do
		if test -x "$dir/aws-cli/aws"; then
			basename "$dir"
		fi
	done | sort -t. -k1,1n -k2,2n -k3,3n
}

no_version_installed() {
	echo "No AWS CLI v2 version is currently installed." >&2
	echo "Run 'awsclienv install' to install one." >&2
}

# Why the version in use is in use: because it was asked for, or because
# nothing was
#
version_source() {
	if test -n "${AWSCLIENV_VERSION:-}"; then
		echo selected
	else
		echo default
	fi
}

# The version to run, which is empty only if the variable is unset and no
# version is installed
#
selected_version() {
	if test -n "${AWSCLIENV_VERSION:-}"; then
		echo "$AWSCLIENV_VERSION"
	else
		local installed
		installed=$(installed_versions)
		echo "${installed##*$'\n'}"
	fi
}

# The most recent version there is, which the CHANGELOG specifies in its first
# few lines, so that a range request over those suffices. The response is
# captured before being parsed, because an awk that stopped reading early would
# leave curl with a broken pipe, failing the whole pipeline under pipefail.
#
latest_version() {
	local head version
	head=$(curl --fail --silent --show-error --location \
		--header 'Range: bytes=0-200' \
		"$changelog_url")
	version=$(
		awk 'prev ~ /^[0-9]+\.[0-9]+\.[0-9]+$/ && /^=+$/ { print prev; exit }
		     { prev = $0 }' <<< "$head"
	)
	if test -z "$version"; then
		echo "Could not tell the latest version from $changelog_url" >&2
		exit 1
	else
		echo "$version"
	fi
}

# Everything but the assignments goes to stderr, leaving stdout machine
# readable, and evaluable at that
#
available_versions() {
	echo >&2
	echo "Versions available for installation are listed at" >&2
	echo >&2
	echo "$changelog_url" >&2
	echo >&2
}

list_versions() {
	local installed current version mark
	installed=$(installed_versions)
	available_versions
	# Having nothing to list is an answer, not a failure, list being a
	# question where purge and aws are an instruction
	if test -z "$installed"; then
		no_version_installed
	else
		echo "To pin this shell to a locally installed version, copy one of" >&2
		echo "the commands listed below and paste it into the shell prompt" >&2
		echo >&2
		# As assignments, so that a line can be copied into the shell as is.
		# The mark on the one in use is a comment, which keeps that line as
		# copyable as the rest, and says whether it is in use because it was
		# asked for or for want of anything having been.
		current=$(selected_version)
		mark="# $(version_source)"
		# A version specified but not installed belongs in the list too,
		# there being nowhere else to learn that the one asked for is absent
		if test ! -x "$versions/$current/aws-cli/aws"; then
			mark="$mark, not installed"
			installed=$(printf '%s\n%s\n' "$installed" "$current" \
				| sort -t. -k1,1n -k2,2n -k3,3n)
		fi
		while read -r version; do
			if test "$version" = "$current"; then
				echo "export AWSCLIENV_VERSION=$version  $mark"
			else
				echo "export AWSCLIENV_VERSION=$version"
			fi
		done <<< "$installed"
	fi
}

purge_versions() {
	local keep installed version
	keep=$(selected_version)
	if test -z "$keep"; then
		no_version_installed
		exit 1
	elif test ! -d "$versions/$keep"; then
		# Purging towards a version that isn't there would delete every
		# version and leave none, which is never what was meant
		echo "AWS CLI v2 version $keep is not installed, so purging would" >&2
		echo "leave none at all. Install it, or unset AWSCLIENV_VERSION." >&2
		exit 1
	else
		installed=$(installed_versions)
		while read -r version; do
			if test "$version" = "$keep"; then
				echo "Kept $versions/$version"
			else
				rm -rf "${versions:?}/${version:?}"
				echo "Deleted $versions/$version"
			fi
		done <<< "$installed"
	fi
}

run() {
	local version
	version=$(selected_version)
	if test -z "$version"; then
		no_version_installed
		exit 1
	elif test -x "$versions/$version/aws-cli/$name"; then
		exec "$versions/$version/aws-cli/$name" "$@"
	elif test -d "$versions/$version"; then
		echo "AWS CLI v2 version $version does not provide $name" >&2
		exit 1
	else
		echo "AWS CLI v2 version $version is not installed." >&2
		echo "Run 'awsclienv install' to install it." >&2
		exit 1
	fi
}

install_version() {
	local version prefix tmp
	if test -n "${AWSCLIENV_VERSION:-}"; then
		version=$AWSCLIENV_VERSION
	else
		version=$(latest_version)
		echo "AWSCLIENV_VERSION is not set, so installing the latest version"
	fi
	prefix=$versions/$version
	if test -x "$prefix/aws-cli/aws"; then
		echo "AWS CLI $version is already installed in $prefix"
	else
		tmp=$(mktemp -d)
		trap 'rm -rf "$tmp"' EXIT
		# curl says what went wrong, down to the status where the server
		# answered at all, but not what it was we wanted, nor where to look
		# for a version that exists
		if ! curl --fail --location --output "$tmp/awscli.pkg" \
				"https://awscli.amazonaws.com/AWSCLIV2-$version.pkg"; then
			echo "Could not download AWS CLI v2 version $version" >&2
			available_versions
			exit 1
		fi
		# The choices file is what relocates the package into $prefix. Left
		# to itself the package installs into /usr/local, which would need
		# root and would leave no room for a second version.
		cat > "$tmp/choices.xml" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<array>
		<dict>
			<key>choiceAttribute</key>
			<string>customLocation</string>
			<key>attributeSetting</key>
			<string>$prefix</string>
			<key>choiceIdentifier</key>
			<string>default</string>
		</dict>
	</array>
</plist>
EOF
		# The installer rejects the choices file unless the custom location
		# exists, so the directory is created up front, and removed again if
		# the install fails, leaving no half-installed version behind.
		mkdir -p "$prefix"
		trap 'rm -rf "$tmp" "$prefix"' EXIT
		installer -pkg "$tmp/awscli.pkg" \
			-target CurrentUserHomeDirectory \
			-applyChoiceChangesXML "$tmp/choices.xml"
		# Cleared before returning, because the trap would otherwise run at
		# exit, by which time these local variables are long out of scope
		trap - EXIT
		rm -rf "$tmp"
		echo "AWS CLI $version is now installed in $prefix"
	fi
}

# The bash startup file, which need not exist yet. A macOS terminal starts a
# login shell, which reads .bash_profile and falls back to .bashrc only by way
# of the user sourcing it there, so .bash_profile is preferred and created if
# neither file exists.
#
startup_file() {
	if test -f "$HOME/.bash_profile"; then
		echo "$HOME/.bash_profile"
	elif test -f "$HOME/.bashrc"; then
		echo "$HOME/.bashrc"
	else
		echo "$HOME/.bash_profile"
	fi
}

# Raised by the functions below when they actually change something, so that
# the advice at the end of activate, deactivate and self-remove is given only
# when there is something for a new shell to pick up
#
changed=false

new_shell_advice() {
	if test "$changed" = true; then
		echo "Open a new shell for this to take effect"
	fi
}

link_shims() {
	local shim
	for shim in aws aws_completer; do
		if test -e "$bin/$shim"; then
			echo "$bin/$shim exists already, leaving it alone"
		else
			ln -s awsclienv "$bin/$shim"
			echo "Linked $bin/$shim to awsclienv"
			changed=true
		fi
	done
}

# The inverse of link_shims, removing only what that function would have
# created and leaving anything else of the same name alone
#
unlink_shims() {
	local shim
	for shim in aws aws_completer; do
		if test -L "$bin/$shim" && test "$(readlink "$bin/$shim")" = awsclienv; then
			rm "$bin/$shim"
			echo "Unlinked $bin/$shim"
			changed=true
		elif test -e "$bin/$shim" || test -L "$bin/$shim"; then
			echo "$bin/$shim is not a link to awsclienv, leaving it alone"
		else
			echo "$bin/$shim does not exist, leaving it alone"
		fi
	done
}

# The line that activate adds to the startup file and deactivate removes from
# it. The shims are referred to by name rather than by path, because the PATH
# entry that self_install adds is what makes them reachable.
#
activation_line() {
	echo 'complete -C aws_completer aws'
}

# How awsclienv arrives in the first place: a shell reading it from a pipe
# runs this. It downloads rather than copies itself, the shell having consumed
# the pipe already, leaving nothing on disk to copy from.
#
self_install() {
	local file line path_live=true line_added=false advice=
	mkdir -p "$install_dir"
	curl --fail --silent --show-error --location \
		--output "$install_dir/awsclienv.download" \
		"$base_url/bin/awsclienv"
	# Only a complete download replaces an installed awsclienv, so that a
	# failure part way through leaves the working copy alone. Replacing it is
	# a matter of the directory entry, not the file, which matters when the
	# caller is self-update: bash reads a script as it runs it.
	chmod +x "$install_dir/awsclienv.download"
	mv "$install_dir/awsclienv.download" "$install_dir/awsclienv"
	echo "Downloaded awsclienv to $install_dir"

	file=$(startup_file)
	# Not the expanded path, so that the line survives a different home
	# directory
	line='export PATH="$HOME/.awsclienv/bin:$PATH"'
	if test -f "$file" && grep -qF "$line" "$file"; then
		echo "$file puts $install_dir on the PATH already"
	else
		printf '\n%s\n' "$line" >> "$file"
		echo "Added $install_dir to the PATH in $file"
		line_added=true
	fi

	# The shell that ran this has the PATH it started with, which this script,
	# being a child of it, cannot change
	case ":${PATH:-}:" in
		*":$install_dir:"*)
			;;
		*)
			path_live=false
			;;
	esac

	line='complete -C awsclienv awsclienv'
	if test -f "$file" && grep -qF "$line" "$file"; then
		echo "$file completes awsclienv already"
	else
		printf '%s\n' "$line" >> "$file"
		echo "Added completion for awsclienv to $file"
		line_added=true
	fi

	# Linked shims mean activate has run, so this is an update rather than a
	# first install: there is nowhere to send the user on to, and only a line
	# written just now would call for a new shell
	if test -e "$install_dir/aws"; then
		if test "$line_added" = true; then
			advice="Open a new shell for this to take effect"
		fi
	elif test "$line_added" = true || test "$path_live" = false; then
		advice="Open a new shell, then run 'awsclienv activate'"
	else
		advice="Next, run 'awsclienv activate'"
	fi
	if test -n "$advice"; then
		echo
		echo "$advice"
		echo
	fi
}

# Replaces the installed awsclienv with the one at the base URL, by the means
# that installed it in the first place: a shell reading it from a pipe.
#
self_update() {
	curl --fail --silent --show-error --location \
		"$base_url/bin/awsclienv" | bash
}

activate() {
	local file line
	changed=false
	file=$(startup_file)
	line=$(activation_line)
	link_shims
	if test -f "$file" && grep -qF "$line" "$file"; then
		echo "$file invokes awsclienv already, leaving it alone"
	else
		printf '\n%s\n' "$line" >> "$file"
		echo "Added to $file:"
		echo "    $line"
		changed=true
	fi
	new_shell_advice
}

# Takes the empty line that may precede the given one with it, while leaving
# empty lines elsewhere in the file alone
#
remove_line() {
	local file=$1 line=$2 tmp
	if test -f "$file" && grep -qF "$line" "$file"; then
		tmp=$(mktemp)
		trap 'rm -f "$tmp"' EXIT
		awk -v target="$line" '
			/^$/ { if (held) print ""; held = 1; next }
			$0 == target { held = 0; next }
			{ if (held) print ""; held = 0; print }
			END { if (held) print "" }
		' "$file" > "$tmp"
		# Written back in place, rather than moved over, so that the startup
		# file keeps its own permissions
		cat "$tmp" > "$file"
		trap - EXIT
		rm -f "$tmp"
		echo "Removed from $file:"
		echo "    $line"
		changed=true
	else
		echo "$file does not have this line, leaving it alone:"
		echo "    $line"
	fi
}

_deactivate() {
	local file
	file=$(startup_file)
	unlink_shims
	remove_line "$file" "$(activation_line)"
}

deactivate() {
	changed=false
	_deactivate
	new_shell_advice
}

# Removes every trace of awsclienv: the lines the install put in the startup
# file, what activate added on top of them, and everything below
# ~/.awsclienv, the versions of the AWS CLI included. Deactivating comes
# first, so that no shim is left pointing at a file about to go. Unlinking the
# directory this script is running from is safe, the file it is being read
# from outliving its name.
#
self_remove() {
	local file
	changed=false
	_deactivate
	file=$(startup_file)
	remove_line "$file" 'export PATH="$HOME/.awsclienv/bin:$PATH"'
	remove_line "$file" 'complete -C awsclienv awsclienv'
	if test -d "$awsclienv_dir"; then
		rm -rf "${awsclienv_dir:?}"
		echo "Removed $awsclienv_dir and everything below it"
	else
		echo "$awsclienv_dir does not exist, leaving it alone"
	fi
	new_shell_advice
}

if test ${#BASH_SOURCE[@]} -eq 0; then
	# No source file, so a shell is reading this from a pipe, which is how
	# awsclienv is installed. The test comes first because $0 is then the
	# shell, which the dispatch on the name below would take for a shim.
	self_install
elif test "$name" != awsclienv; then
	run "$@"
elif test -n "${COMP_LINE:-}"; then
	complete_subcommand "${1:-}" "${2:-}" "${3:-}"
elif test $# -eq 0; then
	usage
	current=$(selected_version)
	if test -z "$current"; then
		:
	elif test -x "$versions/$current/aws-cli/aws"; then
		echo
		echo "The current version is $current ($(version_source))"
	else
		echo
		echo "The current version is $current ($(version_source))," \
			"but it is not installed"
	fi
	echo
else
	subcommand=$1
	shift
	if test "$subcommand" = activate; then
		check_no_args "$subcommand" "$@"
		activate
	elif test "$subcommand" = install; then
		check_no_args "$subcommand" "$@"
		install_version
	elif test "$subcommand" = list; then
		check_no_args "$subcommand" "$@"
		list_versions
	elif test "$subcommand" = purge; then
		check_no_args "$subcommand" "$@"
		purge_versions
	elif test "$subcommand" = deactivate; then
		check_no_args "$subcommand" "$@"
		deactivate
	elif test "$subcommand" = self-update; then
		check_no_args "$subcommand" "$@"
		self_update
	elif test "$subcommand" = self-remove; then
		check_no_args "$subcommand" "$@"
		self_remove
	else
		echo "Unknown subcommand: $subcommand" >&2
		usage >&2
		exit 1
	fi
fi
